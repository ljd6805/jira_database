{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jira-knowledge-review-schema-v0.3",
  "title": "Jira Knowledge Defect Review Schema v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_key",
    "score",
    "verdict",
    "critical_error",
    "major_issue_count",
    "category_scores",
    "audit_findings",
    "critical_issues",
    "major_issues",
    "improvement_points"
  ],
  "properties": {
    "issue_key": {"type": "string"},
    "score": {"type": "number", "minimum": 0, "maximum": 10},
    "verdict": {"enum": ["PASS", "REGENERATE"]},
    "critical_error": {"type": "boolean"},
    "major_issue_count": {"type": "integer", "minimum": 0},
    "category_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual_fidelity",
        "evidence_coverage",
        "certainty_preservation",
        "classification",
        "retrieval_value",
        "language_quality"
      ],
      "properties": {
        "factual_fidelity": {"type": "number", "minimum": 0, "maximum": 3},
        "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 2},
        "certainty_preservation": {"type": "number", "minimum": 0, "maximum": 1.5},
        "classification": {"type": "number", "minimum": 0, "maximum": 1.5},
        "retrieval_value": {"type": "number", "minimum": 0, "maximum": 1},
        "language_quality": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "audit_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_audit",
        "causal_claim_audit",
        "evidence_audit",
        "classification_audit",
        "missing_knowledge_audit",
        "duplication_audit"
      ],
      "properties": {
        "fact_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
        "causal_claim_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
        "evidence_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
        "classification_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
        "missing_knowledge_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
        "duplication_audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}}
      }
    },
    "critical_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "major_issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue_item"}
    },
    "improvement_points": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/issue_item"}
    }
  },
  "$defs": {
    "audit_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "message"],
      "properties": {
        "location": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "issue_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "location", "message"],
      "properties": {
        "type": {"type": "string"},
        "location": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
