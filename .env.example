# 실제 값은 .env에 작성합니다. .env는 Git에서 제외됩니다.
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=
JIRA_PASSWORD=

# 사내 BGE-M3 endpoint와 인증정보는 public config에 하드코딩하지 않습니다.
# 실제 endpoint는 OpenAI-compatible embeddings API의 전체 URL을 입력합니다.
BGE_M3_ENDPOINT=
BGE_M3_API_KEY=

# Bearer token이 아니라 사내 custom header를 사용하는 경우 JSON object로 입력합니다.
# 실제 header 이름/값은 .env에만 기록하고 repository/문서에는 넣지 않습니다.
# 예: BGE_M3_HEADERS_JSON='{"X-Custom-Header":"value"}'
BGE_M3_HEADERS_JSON=
